item) == 0.0\n+        assert dataset.score_answer(answer=\"banana\", entry=item) == 0.0\n+        assert dataset.score_answer(answer=\"\", entry=item) == 0.0\n         assert dataset.score_answer(answer=None, entry=item) == 0.0\n \n "}]}